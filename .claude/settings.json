{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Agent|Task|SendMessage|CronCreate|mcp__claude-code-remote__send_message|mcp__claude-code-remote__create_session|mcp__claude-code-remote__create_trigger|mcp__claude-code-remote__update_trigger|mcp__claude-code-remote__send_later|mcp__claude-code-remote__fire_trigger",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/inject_prefix.py\"",
            "timeout": 10,
            "onFailure": "block",
            "statusMessage": "Adding the Operating Instructions"
          }
        ]
      }
    ]
  }
}
