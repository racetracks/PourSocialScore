{
  "hooks": {
    "SubagentStart": [
      {"matcher": "executor|planner", "hooks": [{"type": "command", "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/inject_prefix.py\" start", "timeout": 10, "onFailure": "block"}]}
    ],
    "SubagentStop": [
      {"matcher": "executor|planner", "hooks": [{"type": "command", "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/inject_prefix.py\" stop", "timeout": 10}]}
    ],
    "PreToolUse": [
      {"matcher": "Agent|Task", "hooks": [{"type": "command", "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/inject_prefix.py\" brief", "timeout": 10, "statusMessage": "Checking the brief"}]},
      {"matcher": "CronCreate|mcp__claude-code-remote__send_message|mcp__claude-code-remote__create_session|mcp__claude-code-remote__create_trigger|mcp__claude-code-remote__update_trigger|mcp__claude-code-remote__send_later|mcp__claude-code-remote__fire_trigger", "hooks": [{"type": "command", "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/inject_prefix.py\" prefix", "timeout": 10, "onFailure": "block", "statusMessage": "Adding the Operating Instructions"}]}
    ]
  }
}
